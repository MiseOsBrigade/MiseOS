{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miseos.dev/schemas/clickable-character.manifest.schema.json",
  "title": "MiseOS Clickable Character Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "characterId",
    "asset",
    "hotspots",
    "policies"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "characterId": {
      "type": "string",
      "minLength": 1
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pngPath",
        "sha256"
      ],
      "properties": {
        "pngPath": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "hotspots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "shape",
          "actionId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "actionId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "requiresNft": {
            "type": "boolean"
          },
          "nftPolicyId": {
            "type": "string"
          },
          "shape": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "x",
                  "y",
                  "w",
                  "h"
                ],
                "properties": {
                  "type": {
                    "const": "rect"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "w": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "h": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "x",
                  "y",
                  "r"
                ],
                "properties": {
                  "type": {
                    "const": "circle"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "r": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              }
            ]
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicitConsent",
        "noEmbeddedCode",
        "allowlistOnly"
      ],
      "properties": {
        "explicitConsent": {
          "const": true
        },
        "noEmbeddedCode": {
          "const": true
        },
        "allowlistOnly": {
          "const": true
        }
      }
    }
  }
}
