diff --git a/examples/demo-roam.mjs b/examples/demo-roam.mjs
new file mode 100644
index 0000000..bb4a583
--- /dev/null
+++ b/examples/demo-roam.mjs
@@ -0,0 +1,14 @@
+import { RepoRoamer, formatEventLine } from "../src/index.js";
+
+const character = process.argv[2] ?? "kurogami-senpai";
+const roamer = new RepoRoamer({
+  root: ".",
+  character,
+  maxDepth: 4,
+  peek: false
+});
+
+for (let index = 0; index < 8; index += 1) {
+  const event = await roamer.step();
+  console.log(formatEventLine(event));
+}
diff --git a/package.json b/package.json
new file mode 100644
index 0000000..88f6195
--- /dev/null
+++ b/package.json
@@ -0,0 +1,31 @@
+{
+  "name": "@miseos/repo-pet",
+  "version": "0.1.0",
+  "description": "MiseOS Repo Pet: a Shimeji-style terminal mascot that safely roams a repository or container filesystem.",
+  "type": "module",
+  "bin": {
+    "mise-repo-pet": "./bin/mise-roam.mjs",
+    "repo-pet": "./bin/mise-roam.mjs"
+  },
+  "scripts": {
+    "start": "node bin/mise-roam.mjs . --character=orchestra-core",
+    "demo": "node examples/demo-roam.mjs",
+    "roam:repo": "node bin/mise-roam.mjs . --character=kurogami-senpai --max-depth=6 --tick=650",
+    "roam:container": "node bin/mise-roam.mjs / --character=orchestra-core --max-depth=4 --tick=800",
+    "list:characters": "node bin/mise-roam.mjs --list-characters",
+    "test": "node test/smoke.mjs"
+  },
+  "keywords": [
+    "miseos",
+    "repo-pet",
+    "shimeji",
