{
  "name": "miseos-bootstrap-registry",
  "version": "0.3.0",
  "private": true,
  "description": "Integrated bootstrap registry for MiseOS packages, containers, agents, workflows, policies, templates, reliability tooling, analytics, and Mise Orchestra role metadata.",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "validate": "node scripts/validate-registry.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/test.mjs",
    "analytics": "node scripts/analyze-registry.mjs",
    "dashboard": "node scripts/generate-dashboard.mjs",
    "export": "node scripts/export-registry.mjs",
    "snapshot": "node scripts/create-snapshot.mjs",
    "diff": "node scripts/diff-registry.mjs",
    "scope:check": "node scripts/scope-check.mjs",
    "sentinel:dry-run": "node packages/release-sentinel/src/index.js --dry-run",
    "policy:check": "node packages/policy-engine/src/index.js registry/index.json",
    "verify": "pnpm validate && pnpm analytics && pnpm dashboard && pnpm export && pnpm scope:check && pnpm test && pnpm integration:report && pnpm orchestra:summary && pnpm repo-pet:test",
    "integration:report": "node scripts/integration-report.mjs",
    "orchestra:summary": "node packages/orchestra-registry/src/index.js",
    "repo-pet:test": "node packages/repo-roamer/test/smoke.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  }
}
