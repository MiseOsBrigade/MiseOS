{
  "name": "@goodshyt/mise-orchestra",
  "version": "0.1.0",
  "description": "Safe, advisory-first adoption CLI for the Mise DevOps Orchestra. Adds mise.yaml and a non-mutating GitHub Action to any repo without jeopardizing it.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mise-orchestra": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.3",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
