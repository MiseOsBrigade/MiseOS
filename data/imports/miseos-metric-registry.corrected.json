      "domain": "composite",
      "description": "Confidence-aware weighted health across delivery, quality, agents, governance, knowledge, infrastructure, product, and commercial domains.",
      "kind": "composite",
      "unit": "score_0_10",
      "calculation": {
        "expression": "weighted_sum(domain_scores)",
        "inputs": [
          "delivery_score",
          "quality_score",
          "agent_score",
          "governance_score",
          "knowledge_score",
          "infrastructure_score",
          "product_score",
          "commercial_score"
        ],
        "window": "configurable",
        "aggregation": "custom",
        "zero_denominator_policy": "null"
      },
      "direction": "higher_is_better",
      "thresholds": {
        "green": {
          "operator": ">=",
          "value": 8
        },
        "amber": {
          "operator": "between",
          "value": [
            6.5,
            7.99
          ]
        },
        "red": {
          "operator": "<",
          "value": 6.5
        }
      },
      "confidence_policy": {
        "minimum_for_display": 0.7,
        "minimum_for_automation": 0.95,
        "factors": {
          "freshness": 0.15,
          "completeness": 0.2,
