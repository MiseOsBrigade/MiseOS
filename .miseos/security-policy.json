{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema": "miseos.security-policy/v1",
  "status": "candidate",
  "verification": {
    "effects": ["allow", "deny", "indeterminate"],
    "indeterminateIsNotAllow": true,
    "requiredDomains": [
      "identity-binding",
      "key-resolution",
      "delegation",
      "authorization",
      "action-envelope",
      "attestation",
      "provenance"
    ]
  },
  "trustAnchors": {
    "artifactSuppliedKeysAreTrusted": false,
    "externalKeyRegistryRequired": true,
    "unknownRegistryStatus": "indeterminate"
  },
  "replay": {
    "requireNonce": true,
    "requireActionId": true,
    "requireAudience": true,
    "singleUseConsumptionForAuthorityActions": true
  },
  "temporal": {
    "requireIssuedAt": true,
    "requireStrictInstantParsing": true
  },
  "provenance": {
    "selfAssertedClaimsRemainUnverified": true,
    "semanticCorrectnessImpliedByIntegrity": false
  }
}
