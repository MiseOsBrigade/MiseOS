{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miseos.example/schemas/nft-metadata.schema.json",
  "title": "MiseOS NFT Metadata",
  "type": "object",
  "required": ["name", "description", "image", "attributes", "properties"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "image": {"type": "string", "format": "uri"},
    "external_url": {"type": "string", "format": "uri"},
    "animation_url": {"type": "string", "format": "uri"},
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trait_type", "value"],
        "properties": {
          "trait_type": {"type": "string"},
          "value": {"type": ["string", "number"]},
          "display_type": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "properties": {
      "type": "object",
      "required": ["schema", "token_id", "slug", "sha256"],
      "properties": {
        "schema": {"const": "miseos.nft.metadata.v1"},
        "token_id": {"type": "integer", "minimum": 0},
        "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_generation": {"type": ["integer", "string"]},
        "generated_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
