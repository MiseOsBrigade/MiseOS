# =========================================================
# CHATGPT / OPENAI RUNTIME
# =========================================================
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=

OPENAI_MODEL_PRIMARY=gpt-5.5-thinking
OPENAI_MODEL_FAST=gpt-5.5
OPENAI_MODEL_REVIEWER=gpt-5.5-thinking

OPENAI_MAX_OUTPUT_TOKENS=6000
OPENAI_TEMPERATURE=0.2
OPENAI_TIMEOUT_MS=90000

OPENAI_TRACE_ENABLED=true
OPENAI_TRACE_PROJECT=miseos-github-agent

# =========================================================
# GITHUB APP AUTH — PREFERRED OVER PERSONAL ACCESS TOKENS
# =========================================================
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=

# Optional fallback only. Avoid PATs unless absolutely necessary.
GITHUB_TOKEN=
GITHUB_PAT=

# =========================================================
# TARGET REPOSITORY CONTROLS
# =========================================================
GITHUB_OWNER=MiseOsBrigade
GITHUB_REPO=Mise-OS
GITHUB_DEFAULT_BRANCH=main

AGENT_BRANCH_PREFIX=agent/
AGENT_COMMIT_AUTHOR_NAME=MiseOS Agent
AGENT_COMMIT_AUTHOR_EMAIL=agent@miseos.dev

CREATE_PR_BY_DEFAULT=true
ALLOW_DIRECT_PUSH=false
DIRECT_PUSH_ALLOWED_BRANCHES=
PROTECTED_BRANCHES=main,master,production,release

PR_TITLE_PREFIX=[MiseOS Agent]
PR_DEFAULT_LABELS=agentic-update,miseos,needs-review
PR_REVIEWERS=
PR_ASSIGNEES=

# =========================================================
# AGENT SAFETY / GOVERNANCE
# =========================================================
AGENT_NAME=MiseOS GitHub Operator
AGENT_ROLE=repo-steward
AGENT_MODE=advisory

DRY_RUN=true
REQUIRE_HUMAN_APPROVAL=true
APPROVAL_REQUIRED_FOR=direct_push,delete_file,workflow_edit,secret_write,dependency_upgrade

MAX_FILES_PER_RUN=25
MAX_LINES_CHANGED_PER_RUN=3000
MAX_COMMITS_PER_RUN=3

ALLOW_WORKFLOW_EDITS=false
ALLOW_SECRET_WRITES=false
ALLOW_REPO_SETTINGS_EDITS=false
ALLOW_BRANCH_PROTECTION_EDITS=false
ALLOW_DELETE_FILES=false

SAFE_PATH_ALLOWLIST=README.md,docs/**,src/**,.github/workflows/advisory-*.yml
SAFE_PATH_BLOCKLIST=.env,*.pem,*.key,*.p12,*.pfx,node_modules/**,dist/**,build/**

REQUIRE_TESTS_BEFORE_PR=true
REQUIRE_LINT_BEFORE_PR=true
REQUIRE_TYPECHECK_BEFORE_PR=true

# =========================================================
# MISEOS / MORAL-OPERATIONAL GOVERNANCE
# =========================================================
MORAL_GOVERNANCE_ENABLED=true
GOVERNANCE_MODE=ECTI_CSM_STL_KAQ

ECTI_MIN_SCORE=0.75
CSM_MIN_SCORE=0.70
STL_MAX_SCORE=0.25
KAQ_MIN_SCORE=0.70

BLOCK_IF_GOVERNANCE_FAILS=true
GOVERNANCE_REPORT_PATH=docs/governance/agent-run-report.md

AGENT_SIGNATURE_LINE=Every agent has a role. Every role has purpose. Every repo deserves stewardship.

# =========================================================
# WEBHOOK / API BRIDGE
# =========================================================
PUBLIC_BASE_URL=https://your-agent-domain.com
WEBHOOK_URL=https://your-agent-domain.com/github/webhook

INTERNAL_API_SECRET=
ADMIN_API_SECRET=

CORS_ALLOWED_ORIGINS=https://chat.openai.com,https://chatgpt.com
REQUEST_BODY_LIMIT=2mb

RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=500

# =========================================================
# DATABASE / AUDIT LOGGING
# =========================================================
DATABASE_URL=
AUDIT_LOG_ENABLED=true
AUDIT_LOG_TABLE=agent_runs

LOG_LEVEL=info
LOG_REDACT_SECRETS=true

RUN_ID_PREFIX=miseos-run
TRACE_ID_HEADER=x-miseos-trace-id

# =========================================================
# OPTIONAL: CLOUD / DEPLOY TARGETS
# =========================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=miseos-github-agent

VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SENTRY_DSN=
