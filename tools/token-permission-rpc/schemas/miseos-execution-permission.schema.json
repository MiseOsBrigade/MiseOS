{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miseos.local/schemas/miseos-execution-permission.schema.json",
  "title": "MiseOS Execution Permission Request",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "chainId",
      "to",
      "permission"
    ],
    "properties": {
      "chainId": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]+$"
      },
      "from": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "to": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$"
      },
      "permission": {
        "type": "object",
        "required": [
          "type",
          "isAdjustmentAllowed",
          "data"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "isAdjustmentAllowed": {
            "type": "boolean"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "rules": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "type",
            "data"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "data": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}