# Never commit real values.
# Optional: FileOps console HTTP port (defaults to 8787).
FILEOPS_PORT=8787

# Logfire observability (https://logfire-us.pydantic.dev, project miseos/mise-os).
# Required in CI/production so telemetry is exported. Local dev without this
# runs fine; the SDK simply does not export data.
# Local dev alternative: run `npx logfire --base-url='https://logfire-us.pydantic.dev' auth`
# and `npx logfire --base-url='https://logfire-us.pydantic.dev' projects use --org 'miseos' 'mise-os'`.
LOGFIRE_TOKEN=replace_me
