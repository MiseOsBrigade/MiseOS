{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Shimeji Brigade",
  "version": "1.0.0",
  "direction": "Chibi chef-agents in a proof-first MiseOS kitchen.",
  "colors": {
    "bg": "#07130f",
    "panel": "#0f2f25",
    "orange": "#e97b22",
    "gold": "#f2c94c",
    "teal": "#1e9bb8",
    "green": "#38a169",
    "red": "#ff6262",
    "purple": "#a78bfa",
    "text": "#f6f1e7",
    "muted": "#a8c2b6",
    "line": "#245747"
  },
  "typography": {
    "display": "ui-rounded, Nunito, system-ui, sans-serif",
    "body": "Inter, ui-sans-serif, system-ui, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "radii": { "sm": "8px", "md": "14px", "lg": "22px", "pill": "999px" },
  "spacing": { "unit": "4px", "section": "24px", "gutter": "16px" },
  "roles": {
    "primary": "gold",
    "accent": "orange",
    "interactive": "teal",
    "success": "green",
    "danger": "red",
    "agent": "purple"
  }
}
