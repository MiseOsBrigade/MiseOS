{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miseos.dev/schemas/metric-observation.schema.json",
  "title": "MiseOS Metric Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "metric_id",
    "calculated_at",
    "window",
    "value",
    "status",
    "confidence",
    "confidence_factors",
    "dimensions",
    "evidence_snapshot_hash",
    "calculation_version",
    "inputs"
  ],
  "properties": {
    "observation_id": {
      "type": "string",
      "pattern": "^obs_[a-f0-9]{24}$"
    },
    "metric_id": {
      "type": "string",
      "pattern": "^miseos\\.metric\\.[a-z0-9_]+$"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "window": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "status": {
      "enum": [
        "green",
        "amber",
        "red",
        "unknown"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_factors": {
      "type": "object"
    },
    "dimensions": {
      "type": "object"
    },
    "evidence_snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "calculation_version": {
      "type": "string"
    },
    "inputs": {
      "type": "object"
    },
    "automation": {
      "type": "object",
      "required": [
        "eligible",
        "reason"
      ],
      "properties": {
        "eligible": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
