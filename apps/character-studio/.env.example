PORT=3000
FRONTEND_ORIGIN=http://localhost:8080
APP_DOMAIN=localhost
SESSION_TTL_MS=86400000
NONCE_TTL_MS=300000
WORKFLOW_TIMEOUT_MS=30000
MAX_IMAGE_BYTES=10485760

# PEM public key used to verify manifests.
MANIFEST_PUBLIC_KEY_PATH=./keys/manifest-public.pem

# Used only by local signing scripts. Never expose to the API container.
MANIFEST_PRIVATE_KEY_PATH=./keys/manifest-private.pem

# Optional NFT gate.
RPC_URL=
NFT_CONTRACT_ADDRESS=
NFT_TOKEN_STANDARD=ERC721
NFT_TOKEN_ID=
